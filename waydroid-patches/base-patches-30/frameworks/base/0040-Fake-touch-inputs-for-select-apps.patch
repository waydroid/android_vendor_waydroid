From 32e7ae5de0d391cd33be990cda2b49851ad7e092 Mon Sep 17 00:00:00 2001
From: Alessandro Astone <ales.astone@gmail.com>
Date: Sun, 6 Nov 2022 12:47:52 +0100
Subject: [PATCH] Fake touch inputs for select apps

Based on "Core: Add force mouse click as touch toggle"

Co-authored-by: Umang96 <umangleekha3@gmail.com>
Change-Id: Ibe26a1cdc41744ad201427093ec384b9a5a0e4b2
---
 core/java/android/view/ViewRootImpl.java | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/core/java/android/view/ViewRootImpl.java b/core/java/android/view/ViewRootImpl.java
index 18e9ef0e4d05..60cb73391ff1 100644
--- a/core/java/android/view/ViewRootImpl.java
+++ b/core/java/android/view/ViewRootImpl.java
@@ -109,6 +109,7 @@ import android.os.IBinder;
 import android.os.Looper;
 import android.os.Message;
 import android.os.ParcelFileDescriptor;
+import android.os.PatternMatcher;
 import android.os.Process;
 import android.os.RemoteException;
 import android.os.SystemClock;
@@ -177,6 +178,7 @@ import java.io.OutputStream;
 import java.io.PrintWriter;
 import java.lang.ref.WeakReference;
 import java.util.ArrayList;
+import java.util.Arrays;
 import java.util.HashSet;
 import java.util.LinkedList;
 import java.util.List;
@@ -458,6 +460,7 @@ public final class ViewRootImpl implements ViewParent,
     @UnsupportedAppUsage
     FallbackEventHandler mFallbackEventHandler;
     final Choreographer mChoreographer;
+    final boolean mFakeClickAsTouch;
 
     // used in relayout to get SurfaceControl size
     // for BLAST adapter surface setup
@@ -794,6 +797,16 @@ public final class ViewRootImpl implements ViewParent,
 
         loadSystemProperties();
         mImeFocusController = new ImeFocusController(this);
+
+        String packageName = context.getPackageName();
+        mFakeClickAsTouch = Arrays.stream(SystemProperties.get("persist.waydroid.fake_touch").split(","))
+            .map(x -> x.replace(".", "\\."))
+            .map(x -> x.replace("*", ".*"))
+            .map(x -> new PatternMatcher(x, PatternMatcher.PATTERN_SIMPLE_GLOB))
+            .anyMatch(p -> p.match(packageName));
+
+        if (mFakeClickAsTouch)
+            Log.d(TAG, "Faking touch inputs for " + packageName);
     }
 
     public static void addFirstDrawHandler(Runnable callback) {
@@ -8049,6 +8062,14 @@ public final class ViewRootImpl implements ViewParent,
         Trace.asyncTraceBegin(Trace.TRACE_TAG_VIEW, "deliverInputEvent",
                 q.mEvent.getId());
 
+        if (mFakeClickAsTouch && q.mEvent instanceof MotionEvent) {
+            MotionEvent ev = (MotionEvent) q.mEvent;
+            int action = ev.getAction();
+            if (action == MotionEvent.ACTION_MOVE || action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_UP) {
+                ev.setSource(4098);
+            }
+        }
+
         if (Trace.isTagEnabled(Trace.TRACE_TAG_VIEW)) {
             Trace.traceBegin(Trace.TRACE_TAG_VIEW, "deliverInputEvent src=0x"
                     + Integer.toHexString(q.mEvent.getSource()) + " eventTimeNano="
-- 
2.49.0

