diff --git a/loader/Loader.cpp b/loader/Loader.cpp
index cde6447..c4ef1f6 100644
--- a/loader/Loader.cpp
+++ b/loader/Loader.cpp
@@ -48,6 +48,7 @@
 #include <android-base/cmsg.h>
 #include <android-base/file.h>
 #include <android-base/logging.h>
