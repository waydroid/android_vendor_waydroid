From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Fri, 20 Nov 2026 11:14:55 +0200
Subject: [PATCH] keystore2: Ignore selinux checks on grant

There is no calling SID here either, so every grant failed. This broke the
recoverable keystore that passkeys rely on. Keep the ownership checks.

Change-Id: Ic50b4483d4155389b57138b42a6f1883fb1a1e7b
---
 keystore2/src/utils.rs | 19 ++++++++-----------
 1 file changed, 8 insertions(+), 11 deletions(-)

diff --git a/keystore2/src/utils.rs b/keystore2/src/utils.rs
index 43c107da32e2..329dd6ee4799 100644
--- a/keystore2/src/utils.rs
+++ b/keystore2/src/utils.rs
@@ -18,7 +18,6 @@
 use crate::error::{map_binder_status, map_km_error, Error, ErrorCode};
 use crate::key_parameter::KeyParameter;
 use crate::ks_err;
-use crate::permission;
 use crate::permission::{KeyPerm, KeyPermSet, KeystorePerm};
 pub use crate::watchdog_helper::watchdog;
 use crate::{
@@ -133,16 +132,14 @@ pub fn check_keystore_permission(_perm: KeystorePerm) -> anyhow::Result<()> {
 /// combination with with_calling_sid from the binder crate to check
 /// if the caller has the given grant permission.
 pub fn check_grant_permission(access_vec: KeyPermSet, key: &KeyDescriptor) -> anyhow::Result<()> {
-    ThreadState::with_calling_sid(|calling_sid| {
-        permission::check_grant_permission(
-            AppUid::calling(),
-            calling_sid
-                .ok_or_else(Error::sys)
-                .context(ks_err!("Cannot check permission without calling_sid."))?,
-            access_vec,
-            key,
-        )
-    })
+    // No calling SID here either, so keep only the checks that do not need SELinux.
+    if key.domain == Domain::APP && AppUid::calling().0 != key.nspace {
+        return Err(Error::perm()).context(ks_err!("Trying to grant a key without ownership."));
+    }
+    if access_vec.includes(KeyPerm::Grant) {
+        return Err(Error::perm()).context(ks_err!("Grant permission cannot be granted."));
+    }
+    Ok(())
 }
 
 /// This function uses its namesake in the permission module and in
