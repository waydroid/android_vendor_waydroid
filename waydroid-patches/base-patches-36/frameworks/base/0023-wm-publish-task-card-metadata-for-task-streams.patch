 public class DisplayContentTests extends WindowTestsBase {
 
     @SetupWindows(addAllCommonWindows = true)
+    @Test
+    public void testWaydroidTransientCardMetadata() {
+        final Task parent = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        final Task popup = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        doReturn(true).when(parent).isVisible();
+        doReturn(true).when(popup).isVisible();
+        doReturn(false).when(popup.getTopNonFinishingActivity()).occludesParent();
+        mDisplayContent.mFocusedApp = popup.getTopNonFinishingActivity();
+        popup.mSurfaceAnimator.mLeash = mock(SurfaceControl.class);
+        clearInvocations(mTransaction);
+
+        mDisplayContent.updateWaydroidTaskCards();
+
+        verify(mTransaction).setMetadata(popup.mSurfaceControl, 0x57590001, parent.mTaskId);
+        verify(mTransaction).setMetadata(popup.mSurfaceAnimator.mLeash, 0x57590001,
+                parent.mTaskId);
+        verify(mTransaction).setMetadata(popup.mSurfaceControl, 0x57590002, 1);
+        verify(mTransaction).setMetadata(parent.mSurfaceControl, 0x57590002, 0);
+    }
+
+    @Test
+    public void testWaydroidTransientChainSharesOneCard() {
+        final Task parent = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        final Task popup = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        final Task child = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        doReturn(true).when(parent).isVisible();
+        doReturn(true).when(popup).isVisible();
+        doReturn(true).when(child).isVisible();
+        doReturn(false).when(popup.getTopNonFinishingActivity()).occludesParent();
+        doReturn(false).when(child.getTopNonFinishingActivity()).occludesParent();
+        clearInvocations(mTransaction);
+
+        mDisplayContent.updateWaydroidTaskCards();
+
+        verify(mTransaction).setMetadata(popup.mSurfaceControl, 0x57590001, parent.mTaskId);
+        verify(mTransaction).setMetadata(child.mSurfaceControl, 0x57590001, parent.mTaskId);
+    }
+
+    @Test
+    public void testWaydroidOpaqueTaskKeepsOwnCard() {
+        final Task parent = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        final Task other = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        doReturn(true).when(parent).isVisible();
+        doReturn(true).when(other).isVisible();
+        doReturn(true).when(other.getTopNonFinishingActivity()).occludesParent();
+        clearInvocations(mTransaction);
+
+        mDisplayContent.updateWaydroidTaskCards();
+
+        verify(mTransaction).setMetadata(other.mSurfaceControl, 0x57590001, other.mTaskId);
+    }
+
+    @Test
+    public void testWaydroidTransientWithoutVisibleParentKeepsOwnCard() {
+        final Task parent = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        final Task popup = new TaskBuilder(mSupervisor).setDisplay(mDisplayContent)
+                .setCreateActivity(true).build().getRootTask();
+        doReturn(false).when(parent).isVisible();
+        doReturn(true).when(popup).isVisible();
+        doReturn(false).when(popup.getTopNonFinishingActivity()).occludesParent();
+        clearInvocations(mTransaction);
+
+        mDisplayContent.updateWaydroidTaskCards();
+
+        verify(mTransaction).setMetadata(popup.mSurfaceControl, 0x57590001, popup.mTaskId);
+    }
+
     @Test
     public void testForAllWindows() {
         final var exitingAppWin = newWindowBuilder("exitingAppWin", TYPE_BASE_APPLICATION)
