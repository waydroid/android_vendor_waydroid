From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Thu, 5 Nov 2026 15:58:28 +0200
Subject: [PATCH] wm: publish task card metadata for task streams

Tag root tasks with card, focus and uid metadata, and name crash/ANR
dialog surfaces so the hwcomposer can place them.

Change-Id: I71db8eea56dd4f2c0052753a76cd69adc86fda4a
---
 .../com/android/server/wm/DisplayContent.java | 39 ++++++++++
 .../server/wm/WindowStateAnimator.java        |  8 ++
 .../server/wm/DisplayContentTests.java        | 75 +++++++++++++++++++
 3 files changed, 122 insertions(+)

diff --git a/services/core/java/com/android/server/wm/DisplayContent.java b/services/core/java/com/android/server/wm/DisplayContent.java
index 96860526c..0fd446e2c 100644
--- a/services/core/java/com/android/server/wm/DisplayContent.java
+++ b/services/core/java/com/android/server/wm/DisplayContent.java
@@ -5703,10 +5703,49 @@ class DisplayContent extends RootDisplayArea implements WindowManagerPolicy.Disp
         child.assignRelativeLayer(t, mImeWindowsContainer.getSurfaceControl(), 1);
     }
 
+    // Private SF capture metadata; keep keys in sync with WaydroidTaskStreams.cpp.
+    private static final int WAYDROID_CARD = 0x57590001;
+    private static final int WAYDROID_FOCUSED = 0x57590002;
+    private static final int WAYDROID_UID = 0x57590003;
+
+    @VisibleForTesting
+    void updateWaydroidTaskCards() {
+        if (mDisplayId != DEFAULT_DISPLAY) {
+            return;
+        }
+        final Task[] below = {null};
+        final Task focused = mFocusedApp != null ? mFocusedApp.getRootTask() : null;
+        forAllRootTasks((java.util.function.Consumer<Task>) task -> {
+            final ActivityRecord top = task.getTopNonFinishingActivity();
+            int card = task.mTaskId;
+            if (task.isVisible() && top != null && !task.isActivityTypeHomeOrRecents()) {
+                if (!top.occludesParent() && below[0] != null
+                        && below[0].mUserId == task.mUserId) {
+                    card = below[0].mTaskId;
+                } else {
+                    below[0] = task;
+                }
+            } else {
+                below[0] = null;
+            }
+            final SurfaceControl.Transaction t = getPendingTransaction();
+            final SurfaceControl[] surfaces = {task.mSurfaceControl, task.mSurfaceAnimator.mLeash};
+            for (SurfaceControl surface : surfaces) {
+                if (surface == null) continue;
+                t.setMetadata(surface, WAYDROID_CARD, card);
+                t.setMetadata(surface, WAYDROID_FOCUSED, task == focused ? 1 : 0);
+                t.setMetadata(surface, WAYDROID_UID, top != null ? top.getUid() : -1);
+            }
+        }, false /* traverseTopToBottom */);
+    }
+
     @Override
     void prepareSurfaces() {
         Trace.traceBegin(TRACE_TAG_WINDOW_MANAGER, "prepareSurfaces");
         try {
+            if (android.os.SystemProperties.getBoolean("persist.waydroid.task_streams", false)) {
+                updateWaydroidTaskCards();
+            }
             super.prepareSurfaces();
         } finally {
             Trace.traceEnd(TRACE_TAG_WINDOW_MANAGER);
