+    ],
     cflags: [
         "-DANDROID_UTILS_REF_BASE_DISABLE_IMPLICIT_CONSTRUCTION",
         "-DLOG_TAG=\"SurfaceFlinger\"",
@@ -112,6 +115,7 @@ cc_defaults {
         "libtonemap",
     ],
     header_libs: [
+        "vendor.waydroid.display-headers",
         "android.hardware.graphics.composer3-command-buffer",
