From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Mon, 20 Jul 2026 12:15:12 +0300
Subject: [PATCH] surfaceflinger: Build against the Waydroid display HIDL
 extension

The IWaydroidDisplay extension used by HidlComposerHal lives in
hardware/waydroid, which surfaceflinger cannot depend on directly, so pull
in its generated headers through vendor.waydroid.display-headers.

Add the includes the extension needs and the matching mock methods, without
which the surfaceflinger unit tests no longer build.
---
 services/surfaceflinger/Android.bp                             | 3 +++
 services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp    | 1 +
 services/surfaceflinger/DisplayHardware/HidlComposerHal.h      | 1 +
 .../tests/unittests/mock/DisplayHardware/MockComposer.h        | 2 ++
 .../tests/unittests/mock/DisplayHardware/MockHWC2.h            | 2 ++
 5 files changed, 9 insertions(+)

diff --git a/services/surfaceflinger/Android.bp b/services/surfaceflinger/Android.bp
index 0944f0ac6d..0ac782759f 100644
--- a/services/surfaceflinger/Android.bp
+++ b/services/surfaceflinger/Android.bp
@@ -27,6 +27,9 @@ cc_aconfig_library {
 
 cc_defaults {
     name: "surfaceflinger_defaults",
+    header_libs: [
+        "vendor.waydroid.display-headers",
+    ],
     cflags: [
         "-DANDROID_UTILS_REF_BASE_DISABLE_IMPLICIT_CONSTRUCTION",
         "-DLOG_TAG=\"SurfaceFlinger\"",
diff --git a/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp b/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp
index 1fc09e8cde..461794b214 100644
--- a/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp
+++ b/services/surfaceflinger/DisplayHardware/HidlComposerHal.cpp
@@ -22,6 +22,7 @@
 
 #include "HidlComposerHal.h"
 
+#include <binder/Parcel.h>
 #include <SurfaceFlingerProperties.h>
 #include <aidl/android/hardware/graphics/common/DisplayHotplugEvent.h>
 #include <android/binder_manager.h>
diff --git a/services/surfaceflinger/DisplayHardware/HidlComposerHal.h b/services/surfaceflinger/DisplayHardware/HidlComposerHal.h
index 2cca6d89ad..75f1de6a1e 100644
--- a/services/surfaceflinger/DisplayHardware/HidlComposerHal.h
+++ b/services/surfaceflinger/DisplayHardware/HidlComposerHal.h
@@ -18,6 +18,7 @@
 
 #include "ComposerHal.h"
 
+#include <map>
 #include <optional>
 #include <string>
 #include <unordered_map>
diff --git a/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockComposer.h b/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockComposer.h
index bd163555a2..cc59507eab 100644
--- a/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockComposer.h
+++ b/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockComposer.h
@@ -125,6 +125,8 @@ public:
     MOCK_METHOD3(setLayerVisibleRegion,
                  Error(Display, Layer, const std::vector<IComposerClient::Rect>&));
     MOCK_METHOD3(setLayerZOrder, Error(Display, Layer, uint32_t));
+    MOCK_METHOD3(setLayerName, Error(Display, Layer, std::string));
+    MOCK_METHOD3(setLayerHandleInfo, Error(Display, Layer, const sp<GraphicBuffer>&));
     MOCK_METHOD3(getRenderIntents, Error(Display, ColorMode, std::vector<RenderIntent>*));
     MOCK_METHOD3(setLayerColorTransform, Error(Display, Layer, const float*));
     MOCK_METHOD4(getDisplayedContentSamplingAttributes,
diff --git a/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockHWC2.h b/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockHWC2.h
index 8974ee8297..6175350fb4 100644
--- a/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockHWC2.h
+++ b/services/surfaceflinger/tests/unittests/mock/DisplayHardware/MockHWC2.h
@@ -160,6 +160,8 @@ public:
     MOCK_METHOD(hal::Error, setVisibleRegion, (const android::Region &), (override));
     MOCK_METHOD(hal::Error, setZOrder, (uint32_t), (override));
     MOCK_METHOD(hal::Error, setColorTransform, (const android::mat4 &), (override));
+    MOCK_METHOD(hal::Error, setLayerName, (std::string), (override));
+    MOCK_METHOD(hal::Error, setLayerHandleInfo, (const sp<GraphicBuffer>&), (override));
     MOCK_METHOD(hal::Error, setLayerGenericMetadata,
                 (const std::string &, bool, const std::vector<uint8_t> &), (override));
     MOCK_METHOD(hal::Error, setBrightness, (float), (override));
