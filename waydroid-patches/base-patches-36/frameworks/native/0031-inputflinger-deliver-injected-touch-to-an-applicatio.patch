-                ALOGD("%s", log.c_str());
+    // Ordinary Android input must honor Android's own stacking and occlusion
+    // policy. A Droidloom event is different: Denial has already hit-tested
+    // its native window and supplied the exact application token. Android's
+    // flattened full-screen stack is not the visible host z-order, so applying
+    // it here would reject legitimate input to every Droidloom window except
+    // whichever Android task happens to be internally topmost.
+    const bool hasExternalApplicationTarget =
+            motionEntry.injectionState != nullptr &&
+            motionEntry.injectionState->targetApplicationToken != nullptr;
+    if (!hasExternalApplicationTarget) {
+        const auto [x, y] = resolveTouchedPosition(motionEntry);
+        DispatcherWindowInfo::TouchOcclusionInfo occlusionInfo =
+                mWindowInfos.computeTouchOcclusionInfo(window, x, y);
+        if (!mWindowInfos.isTouchTrusted(occlusionInfo)) {
+            if (DEBUG_TOUCH_OCCLUSION) {
+                ALOGD("Stack of obscuring windows during untrusted touch (%.1f, %.1f):", x, y);
+                for (const auto& log : occlusionInfo.debugInfo) {
+                    ALOGD("%s", log.c_str());
+                }
             }
+            ALOGW("Dropping untrusted touch event due to %s/%s",
+                  occlusionInfo.obscuringPackage.c_str(),
+                  occlusionInfo.obscuringUid.toString().c_str());
