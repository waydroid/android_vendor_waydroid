 // Checks targeted injection using the window's owner's uid.
 // Returns an empty string if an entry can be sent to the given window, or an error message if the
+// Waydroid: windows a task's card shows without them belonging to its activity
+// (keyboard, system dialogs) take the touches targeted at that card too.
+bool acceptsTargetedTouch(const sp<WindowInfoHandle>& window, const sp<IBinder>& token) {
+    if (window->getApplicationToken() == token) return true;
+    using Type = gui::WindowInfo::Type;
+    switch (window->getInfo()->layoutParamsType) {
+        case Type::INPUT_METHOD:
+        case Type::INPUT_METHOD_DIALOG:
+        case Type::SYSTEM_ALERT:
+        case Type::SYSTEM_DIALOG:
+        case Type::SYSTEM_ERROR:
+            return true;
+        default:
+            return false;
+    }
+}
