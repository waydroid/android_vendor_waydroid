From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Fri, 6 Nov 2026 09:16:46 +0200
Subject: [PATCH] surfaceflinger: gate task streams only while the task moves

The stability gate withheld every frame whose layer geometry changed,
so transitions inside an app froze and then jumped. Only hold frames
while the task layer itself animates (launch, task switch, spread).

Change-Id: I3c4388fde01dec5b6388abbeab48870b60efac83
---
 .../surfaceflinger/WaydroidTaskStreams.cpp    | 46 ++++++++++---------
 services/surfaceflinger/WaydroidTaskStreams.h |  4 +-
 2 files changed, 27 insertions(+), 23 deletions(-)

diff --git a/services/surfaceflinger/WaydroidTaskStreams.cpp b/services/surfaceflinger/WaydroidTaskStreams.cpp
index 319aa2db..25edaa0d 100644
--- a/services/surfaceflinger/WaydroidTaskStreams.cpp
+++ b/services/surfaceflinger/WaydroidTaskStreams.cpp
@@ -249,6 +249,7 @@ void WaydroidTaskStreams::onCompositionPresented(const frontend::LayerHierarchy&
     std::unordered_map<int32_t, int32_t> uidCards;
     std::vector<std::pair<int32_t, int32_t>> owners;
     int32_t focusedCard = -1;
+    std::vector<std::pair<size_t, uint32_t>> roots; // (task index, task layer)
     auto collect = [](const frontend::LayerHierarchy& root, auto& ids) {
         root.traverse([&](const auto& node, const auto& path) {
             if (path.variant == frontend::LayerHierarchy::Variant::Detached) return false;
@@ -267,6 +268,7 @@ void WaydroidTaskStreams::onCompositionPresented(const frontend::LayerHierarchy&
         if (inserted) tasks.push_back({cardId, {}, {}});
         auto& task = tasks[it->second];
         task.members.push_back(static_cast<uint32_t>(taskId));
+        roots.emplace_back(it->second, node.getLayer()->id);
         collect(node, task.layerIds);
         const int32_t uid = metadata.getInt32(kUid, -1);
         if (uid >= 0) {
@@ -310,6 +312,23 @@ void WaydroidTaskStreams::onCompositionPresented(const frontend::LayerHierarchy&
         return false;
     });
 
+    // Where the tasks themselves are on screen: global transform, bounds and
+    // alpha of each task layer, which window transitions animate.
+    for (const auto& [index, layerId] : roots) {
+        const auto* snapshot = mFlinger.mLayerSnapshotBuilder.getSnapshot(layerId);
+        if (!snapshot) continue;
+        uint64_t& sig = tasks[index].rootSig;
+        const ui::Transform& t = snapshot->geomLayerTransform;
+        const FloatRect& b = snapshot->geomLayerBounds;
+        for (const float f : {t.dsdx(), t.dtdx(), t.dtdy(), t.dsdy(), t.tx(), t.ty(), b.left,
+                              b.top, b.right, b.bottom, snapshot->alpha}) {
+            uint32_t bits;
+            memcpy(&bits, &f, sizeof(bits));
+            sig ^= bits;
+            sig *= 1099511628211ull;
+        }
+    }
+
     {
         std::lock_guard lock(mMutex);
         mPending = std::move(tasks);
@@ -502,28 +521,11 @@ bool WaydroidTaskStreams::renderTask(const TaskCapture& task, TaskStream& stream
         return stream.renderedFrames > 0;
     }
 
-    // Geometry signature: layer set + global transforms + alphas. During
-    // window transitions (launch, task switch, spread) these change every
-    // frame; freezing such a frame into the card is what produced gray and
-    // half-drawn cards. Post only frames whose geometry matches the previous
-    // frame's. A park frame must post now: the card is going away.
-    uint64_t sig = 14695981039346656037ull;
-    const auto mix = [&sig](uint64_t v) {
-        sig ^= v;
-        sig *= 1099511628211ull;
-    };
-    for (const auto& [layer, layerFE] : args.layers) {
-        const auto* snapshot = layerFE->mSnapshot.get();
-        if (!snapshot) continue;
-        mix(snapshot->path.id);
-        const ui::Transform& t = snapshot->geomLayerTransform;
-        for (const float f : {t.dsdx(), t.dtdx(), t.dtdy(), t.dsdy(), t.tx(), t.ty(),
-                              snapshot->alpha}) {
-            uint32_t bits;
-            memcpy(&bits, &f, sizeof(bits));
-            mix(bits);
-        }
-    }
+    // While the task itself animates (launch, task switch, spread), freezing
+    // one of its frames into the card is what produced gray and half-drawn
+    // cards, so post only once its geometry holds. Transitions inside the
+    // task post as usual. A park frame must post now: the card is going away.
+    const uint64_t sig = task.rootSig;
     const bool stable = stream.haveGeometrySig && sig == stream.geometrySig;
     stream.geometrySig = sig;
     stream.haveGeometrySig = true;
diff --git a/services/surfaceflinger/WaydroidTaskStreams.h b/services/surfaceflinger/WaydroidTaskStreams.h
index a5187dad..4a5cbbf2 100644
--- a/services/surfaceflinger/WaydroidTaskStreams.h
+++ b/services/surfaceflinger/WaydroidTaskStreams.h
@@ -59,13 +59,15 @@ public:
 
     // Main thread, after composite() has moved snapshots back into the
     // builder: group layers by task id and wake the render thread.
-    void onCompositionPresented(const surfaceflinger::frontend::LayerHierarchy& hierarchy);
+    void onCompositionPresented(const surfaceflinger::frontend::LayerHierarchy& hierarchy)
+            REQUIRES(kMainThreadContext);
 
 private:
     struct TaskCapture {
         int32_t taskId;
         std::unordered_set<uint32_t> layerIds;
         std::vector<uint32_t> members;
+        uint64_t rootSig = 14695981039346656037ull;
     };
 
     // Three buffers per task: Mir holds current + previous, and a release
