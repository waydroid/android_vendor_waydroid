From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Fri, 6 Nov 2026 10:52:41 +0200
Subject: [PATCH] inputflinger: inject touch for Waydroid task cards

A private transaction for system and root takes a touch event and the
token of the task it belongs to, and reports it from the real touchscreen.

Change-Id: Icbcee53898bd451e9533a00a5a0dc989b96c637e
---
 services/inputflinger/InputManager.cpp | 77 ++++++++++++++++++++++++++
 services/inputflinger/InputManager.h   |  7 +++
 2 files changed, 84 insertions(+)

diff --git a/services/inputflinger/InputManager.cpp b/services/inputflinger/InputManager.cpp
index c6d8d883..559c14b0 100644
--- a/services/inputflinger/InputManager.cpp
+++ b/services/inputflinger/InputManager.cpp
@@ -18,12 +18,14 @@
 
 //#define LOG_NDEBUG 0
 
+#include <array>
 #include <memory>
 
 #include "InputDispatcherFactory.h"
 #include "InputManager.h"
 #include "InputReader.h"
 #include "InputTracingThreadedBackend.h"
+#include "dispatcher/InputDispatcher.h"
 #include "UnwantedInteractionBlocker.h"
 
 #include <aidl/com/android/server/inputflinger/IInputFlingerRust.h>
@@ -300,4 +302,79 @@ binder::Status InputManager::setFocusedWindow(const gui::FocusRequest& request)
     return binder::Status::ok();
 }
 
+// Waydroid: touch from a host window goes straight to the window of the
+// Android task that window shows, whatever Android's focus and z-order say.
+// The caller resolves the task to its application token.
+constexpr uint32_t kWaydroidInjectTaskTouch = 0x57440001;
+constexpr int32_t kMaxTaskTouchPointers = 16;
+
+status_t InputManager::onTransact(uint32_t code, const Parcel& data, Parcel* reply,
+                                  uint32_t flags) {
+    if (code != kWaydroidInjectTaskTouch) return BnInputFlinger::onTransact(code, data, reply, flags);
+    CHECK_INTERFACE(IInputFlinger, data, reply);
+    const uid_t uid = IPCThreadState::self()->getCallingUid();
+    if (uid != AID_ROOT && uid != AID_SYSTEM) return PERMISSION_DENIED;
+    if (reply == nullptr) return BAD_VALUE;
+    return injectTaskTouch(data, reply);
+}
+
+status_t InputManager::injectTaskTouch(const Parcel& data, Parcel* reply) {
+    sp<IBinder> token;
+    int32_t action, count;
+    int64_t downTime, eventTime;
+    status_t status = data.readStrongBinder(&token);
+    status = status ?: data.readInt32(&action);
+    status = status ?: data.readInt64(&downTime);
+    status = status ?: data.readInt64(&eventTime);
+    status = status ?: data.readInt32(&count);
+    if (status != OK || token == nullptr || count <= 0 || count > kMaxTaskTouchPointers) {
+        return BAD_VALUE;
+    }
+    std::array<PointerProperties, kMaxTaskTouchPointers> properties{};
+    std::array<PointerCoords, kMaxTaskTouchPointers> coords{};
+    for (int32_t i = 0; i < count; i++) {
+        int32_t id;
+        float x, y, pressure;
+        status = data.readInt32(&id);
+        status = status ?: data.readFloat(&x);
+        status = status ?: data.readFloat(&y);
+        status = status ?: data.readFloat(&pressure);
+        if (status != OK || id < 0 || id > MAX_POINTER_ID) return BAD_VALUE;
+        properties[i].id = id;
+        properties[i].toolType = ToolType::FINGER;
+        coords[i].setAxisValue(AMOTION_EVENT_AXIS_X, x);
+        coords[i].setAxisValue(AMOTION_EVENT_AXIS_Y, y);
+        coords[i].setAxisValue(AMOTION_EVENT_AXIS_PRESSURE, pressure);
+        coords[i].setAxisValue(AMOTION_EVENT_AXIS_SIZE, 1.0f);
+    }
+
+    // Report the real touchscreen, so apps asking InputDevice see one.
+    if ((action & AMOTION_EVENT_ACTION_MASK) == AMOTION_EVENT_ACTION_DOWN) {
+        int32_t deviceId = -1;
+        for (const InputDeviceInfo& info : mReader->getInputDevices()) {
+            if ((info.getSources() & AINPUT_SOURCE_TOUCHSCREEN) == AINPUT_SOURCE_TOUCHSCREEN) {
+                deviceId = info.getId();
+                break;
+            }
+        }
+        mTouchDeviceId = deviceId;
+    }
+    const int32_t deviceId = std::max(mTouchDeviceId.load(), 0);
+
+    const IdGenerator ids(IdGenerator::Source::OTHER);
+    MotionEvent event;
+    event.initialize(ids.nextId(), deviceId, AINPUT_SOURCE_TOUCHSCREEN,
+                     ui::LogicalDisplayId::DEFAULT, {}, action, 0, {}, 0, 0, 0,
+                     MotionClassification::NONE, ui::Transform{}, 1.0f, 1.0f,
+                     AMOTION_EVENT_INVALID_CURSOR_POSITION, AMOTION_EVENT_INVALID_CURSOR_POSITION,
+                     ui::Transform{}, downTime, eventTime, static_cast<size_t>(count),
+                     properties.data(), coords.data());
+    auto* dispatcher = static_cast<inputdispatcher::InputDispatcher*>(mDispatcher.get());
+    const auto result =
+            dispatcher->injectInputEventToApplication(&event, std::nullopt,
+                                                      os::InputEventInjectionSync::NONE,
+                                                      std::chrono::milliseconds(5000), 0, token);
+    return reply->writeInt32(static_cast<int32_t>(result));
+}
+
 } // namespace android
diff --git a/services/inputflinger/InputManager.h b/services/inputflinger/InputManager.h
index 44cf8c42..ef76aebc 100644
--- a/services/inputflinger/InputManager.h
+++ b/services/inputflinger/InputManager.h
@@ -28,6 +28,7 @@
 #include "include/UnwantedInteractionBlockerInterface.h"
 
 #include <InputDispatcherInterface.h>
+#include <atomic>
 #include <InputDispatcherPolicyInterface.h>
 #include <InputFilterPolicyInterface.h>
 #include <PointerChoreographerPolicyInterface.h>
@@ -141,7 +142,13 @@ public:
     binder::Status removeInputChannel(const sp<IBinder>& connectionToken) override;
     binder::Status setFocusedWindow(const gui::FocusRequest&) override;
 
+    status_t onTransact(uint32_t code, const Parcel& data, Parcel* reply,
+                        uint32_t flags) override;
+
 private:
+    status_t injectTaskTouch(const Parcel& data, Parcel* reply);
+    std::atomic<int32_t> mTouchDeviceId{-1};
+
     std::unique_ptr<InputReaderInterface> mReader;
 
     std::unique_ptr<UnwantedInteractionBlockerInterface> mBlocker;
