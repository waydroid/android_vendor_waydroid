+namespace android {
+
+// Direct layers: a producer buffer shown on the host is read by the host
+// compositor long after SurfaceFlinger is done with it. Returns the fence
+// that signals once the host can no longer read bufferId, or NO_FENCE.
+// Merge it into the buffer's release fence.
+sp<Fence> waydroidHostReadFence(uint64_t bufferId);
+
+// Merges the host read fence of bufferId into releaseFence.
+sp<Fence> waydroidMergeHostRead(uint64_t bufferId, const sp<Fence>& releaseFence);
+
+} // namespace android
