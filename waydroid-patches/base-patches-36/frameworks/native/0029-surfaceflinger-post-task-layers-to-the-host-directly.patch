+// The capture output wants a target even when nothing is rendered: geometry
+// comes from the source crop and requested size, so any buffer will do.
+const std::shared_ptr<renderengine::ExternalTexture>& WaydroidTaskStreams::probeTarget() {
+    if (!mProbeTarget) {
+        sp<GraphicBuffer> buffer =
+                sp<GraphicBuffer>::make(1u, 1u, PIXEL_FORMAT_RGBA_8888, 1u,
+                                        GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE,
+                                        "WaydroidTaskProbe");
+        mProbeTarget = std::make_shared<
+                renderengine::impl::ExternalTexture>(buffer, mFlinger.getRenderEngine(),
+                                                     renderengine::impl::ExternalTexture::Usage::
+                                                             READABLE);
+    }
+    return mProbeTarget;
+}
+
+// A task that stays direct does not need its composition buffers. Free the
+// ones the host is done with; a later composed frame allocates again.
+void WaydroidTaskStreams::freeTargets(int32_t taskId, TaskStream& stream) {
+    size_t freed = 0;
+    for (auto& s : stream.slots) {
+        if (!s.texture || s.busy) continue;
+        if (s.release && s.release->getStatus() != Fence::Status::Signaled) continue;
+        const uint64_t id = s.texture->getBuffer()->getId();
+        if (stream.sent.erase(id)) stream.forget.push_back(id);
+        s.texture = nullptr;
+        s.release = nullptr;
+        freed++;
+    }
+    if (freed) ALOGI("task %d: direct, freed %zu composition buffers", taskId, freed);
+}
+
+WaydroidTaskStreams::SceneResult WaydroidTaskStreams::tryDirect(
+        const TaskCapture& task, TaskStream& stream, SurfaceFlinger::ScreenshotArgs& args,
+        PendingReads& pending) {
+    // Resolve the geometry exactly as the composed render would (occlusion,
+    // crop, buffer transform), but stop before RenderEngine. A monostate
+    // capture has an identity transform, so the snapshots need no adjusting.
+    std::unique_ptr<compositionengine::CompositionEngine> engine =
+            mFlinger.mFactory.createCompositionEngine();
+    engine->setRenderEngine(mFlinger.mRenderEngine.get());
+    engine->setHwComposer(mFlinger.mHWComposer.get());
+    const compositionengine::Output::ColorProfile colorProfile{
+            .dataspace = ui::Dataspace::V0_SRGB,
+            .renderIntent = ui::RenderIntent::TONE_MAP_COLORIMETRIC};
+    auto output = createScreenCaptureOutput(ScreenCaptureOutputArgs{
+            .compositionEngine = *engine,
+            .colorProfile = colorProfile,
+            .layerStack = args.layers.back().second->getCompositionState()->outputFilter.layerStack,
+            .sourceCrop = args.sourceCrop,
+            .buffer = probeTarget(),
+            .displayIdVariant = args.displayIdVariant,
+            .reqBufferSize = args.size,
+            .sdrWhitePointNits = args.sdrWhitePointNits,
+            .displayBrightnessNits = args.sdrWhitePointNits,
+            .targetBrightness = 1.0f,
+            .layerAlpha = 1.0f,
+            .disableBlur = true,
+            .treat170mAsSrgb = mFlinger.mTreat170mAsSrgb,
+            .dimInGammaSpaceForEnhancedScreenshots = false,
+            .isSecure = true,
+            .enableLocalTonemapping = false,
+            .debugName = "WaydroidTaskScene"});
+    std::vector<sp<compositionengine::LayerFE>> layerFEs;
+    layerFEs.reserve(args.layers.size());
+    for (auto& [_, layerFE] : args.layers) layerFEs.push_back(layerFE);
+    compositionengine::CompositionRefreshArgs refresh{
+            .outputs = {output},
+            .layers = std::move(layerFEs),
+            .updatingOutputGeometryThisFrame = true,
+            .updatingGeometryThisFrame = true,
+    };
+    compositionengine::LayerFESet latched;
+    output->prepare(refresh, latched);
+    output->updateColorProfile(refresh);
+    output->updateCompositionState(refresh);
+
+    const int32_t width = args.size.getWidth();
+    const int32_t height = args.size.getHeight();
+    const char* reason = nullptr;
+    std::vector<SceneLayer> layers;
+    std::unordered_set<uint64_t> buffers;
+    // Scene shape: everything but the content, i.e. which buffers and frames.
+    uint64_t shape = 14695981039346656037ull;
+    const auto mix = [&shape](uint64_t v) {
+        shape ^= v;
+        shape *= 1099511628211ull;
+    };
+    mix(static_cast<uint64_t>(args.size.getWidth()) << 32 |
+        static_cast<uint32_t>(args.size.getHeight()));
+    for (auto* outputLayer : output->getOutputLayersOrderedByZ()) {
+        const auto& o = outputLayer->getState();
+        if (o.visibleRegion.isEmpty()) continue;
+        // LayerFE's composition state is its snapshot.
+        const auto& s = static_cast<const frontend::LayerSnapshot&>(
+                *outputLayer->getLayerFE().getCompositionState());
+        reason = directRejectReason(s, o, width, height);
+        if (reason) break;
+        if (layers.size() == kMaxSceneLayers) {
+            reason = "too many layers";
+            break;
+        }
+        SceneLayer scene{};
+        auto& l = scene.layer;
+        l.layerId = s.uniqueSequence;
+        l.dstLeft = o.displayFrame.left;
+        l.dstTop = o.displayFrame.top;
+        l.dstRight = o.displayFrame.right;
+        l.dstBottom = o.displayFrame.bottom;
+        l.opaque = s.isOpaque;
+        if (!s.externalTexture) {
+            // Solid color (dim layers, backgrounds); alpha is the pixel's.
+            const auto channel = [](float v) {
+                return static_cast<uint32_t>(std::lround(std::clamp(v, 0.0f, 1.0f) * 255));
+            };
+            const float alpha = s.color.a * s.alpha;
+            l.color = channel(alpha) << 24 | channel(s.color.r) << 16 |
+                    channel(s.color.g) << 8 | channel(s.color.b);
+            l.opaque = alpha >= 1.0f;
+            l.srcRight = 1.0f;
+            l.srcBottom = 1.0f;
+        } else {
+            const sp<GraphicBuffer>& buffer = s.externalTexture->getBuffer();
+            if (!buffers.insert(buffer->getId()).second) {
+                reason = "buffer shown twice";
+                break;
+            }
+            l.bufferId = buffer->getId();
+            l.frameNumber = s.frameNumber;
+            l.width = buffer->getWidth();
+            l.height = buffer->getHeight();
+            l.stride = buffer->getStride();
+            l.format = static_cast<int32_t>(buffer->getPixelFormat());
+            l.srcLeft = o.sourceCrop.left;
+            l.srcTop = o.sourceCrop.top;
+            l.srcRight = o.sourceCrop.right;
+            l.srcBottom = o.sourceCrop.bottom;
+            l.transform = static_cast<uint32_t>(o.bufferTransform);
+            scene.buffer = buffer;
+            scene.acquire = s.acquireFence;
+        }
+        mix(l.layerId);
+        mix(static_cast<uint64_t>(l.bufferId != 0) << 63 | static_cast<uint64_t>(l.width) << 32 |
+            l.height);
+        mix(static_cast<uint32_t>(l.format) | static_cast<uint64_t>(l.transform) << 32);
+        for (const int32_t v : {l.dstLeft, l.dstTop, l.dstRight, l.dstBottom}) {
+            mix(static_cast<uint32_t>(v));
+        }
+        for (const float f : {l.srcLeft, l.srcTop, l.srcRight, l.srcBottom}) {
+            uint32_t bits;
+            memcpy(&bits, &f, sizeof(bits));
+            mix(bits);
+        }
+        layers.push_back(std::move(scene));
+    }
+    if (!reason && layers.empty()) reason = "nothing visible";
+    const nsecs_t now = systemTime();
+    if (reason || !stream.haveShape || shape != stream.shape) {
+        stream.shape = shape;
+        stream.haveShape = !reason;
+        stream.shapeSince = now;
+    }
+    if (reason) {
+        if (stream.lastRejectLog == 0 || mFrame - stream.lastRejectLog >= kLogEveryFrames) {
+            stream.lastRejectLog = mFrame;
+            ALOGI("task %d: composing, not direct: %s", task.taskId, reason);
+        }
+        return SceneResult::Unsupported;
+    }
+    // A shape the host could not place stays composed until it changes.
+    if (stream.haveRefusedShape && shape == stream.refusedShape) return SceneResult::Unsupported;
+    if (!stream.lastDirect && now - stream.shapeSince < kSettleNs) return SceneResult::Unsupported;
+
+    std::vector<sp<Fence>> releases;
+    const SceneResult result = postScene(task.taskId, stream, static_cast<uint32_t>(width),
+                                         static_cast<uint32_t>(height), layers, &releases);
+    if (result == SceneResult::Posted) {
+        for (size_t i = 0; i < layers.size() && i < releases.size(); i++) {
+            if (layers[i].buffer) {
+                pending.hostFences[layers[i].layer.bufferId] = releases[i];
+            }
+        }
+    } else if (result == SceneResult::Unsupported) {
+        stream.refusedShape = shape;
+        stream.haveRefusedShape = true;
+    }
+    return result;
+}
+
+WaydroidTaskStreams::SceneResult WaydroidTaskStreams::postScene(
+        int32_t taskId, TaskStream& stream, uint32_t width, uint32_t height,
+        std::vector<SceneLayer>& layers, std::vector<sp<Fence>>* releases) {
+    using ::android::hardware::hidl_handle;
+    using ::android::hardware::hidl_vec;
+    using ::android::hardware::graphics::composer::V2_1::Error;
+    using TaskLayer = ::vendor::waydroid::display::V1_3::IWaydroidDisplay::TaskLayer;
+
+    if (!connectHal()) return SceneResult::Failed;
+
+    // Send each buffer's handle once; the HAL caches the import by id.
+    std::vector<uint64_t> newlySent;
+    hidl_vec<TaskLayer> hidlLayers;
+    hidlLayers.resize(layers.size());
+    for (size_t i = 0; i < layers.size(); i++) {
+        hidlLayers[i] = layers[i].layer;
+        const sp<GraphicBuffer>& buffer = layers[i].buffer;
+        if (!buffer) continue;
+        auto& sent = stream.sent[buffer->getId()];
+        if (!sent.buffer) {
+            hidlLayers[i].buffer.setTo(const_cast<native_handle_t*>(buffer->handle),
+                                       false /*shouldOwn*/);
+            newlySent.push_back(buffer->getId());
+        }
+        sent.buffer = buffer;
+        sent.lastUsedFrame = mFrame;
+        if (layers[i].acquire && layers[i].acquire->isValid()) {
+            const int fd = layers[i].acquire->dup();
+            if (fd >= 0) {
+                native_handle_t* h = native_handle_create(1, 0);
+                h->data[0] = fd;
+                hidlLayers[i].acquireFence.setTo(h, true /*shouldOwn*/);
+            }
+        }
+    }
+
+    // Forget buffers the producers stopped using; this also lets them go.
+    if (stream.sent.size() > kMaxSentBuffers) {
+        for (auto it = stream.sent.begin(); it != stream.sent.end();) {
+            if (it->second.lastUsedFrame + kSentIdleFrames < mFrame) {
+                stream.forget.push_back(it->first);
+                it = stream.sent.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+    hidl_vec<uint64_t> forget(stream.forget);
+
+    Error error = Error::NO_RESOURCES;
+    auto ret = mHal->postTaskScene(static_cast<uint32_t>(taskId), width, height, hidlLayers,
+                                   forget,
+                                   [&](Error e, const hidl_vec<hidl_handle>& fences) {
+                                       error = e;
+                                       if (e != Error::NONE) return;
+                                       releases->reserve(fences.size());
+                                       for (const auto& fence : fences) {
+                                           const native_handle_t* h = fence.getNativeHandle();
+                                           if (h && h->numFds > 0 && h->data[0] >= 0) {
+                                               releases->push_back(sp<Fence>::make(
+                                                       ::dup(h->data[0])));
+                                           } else {
+                                               releases->push_back(Fence::NO_FENCE);
+                                           }
+                                       }
+                                   });
+    if (!ret.isOk()) {
+        ALOGW("display@1.3 died (%s), reconnecting", ret.description().c_str());
+        mHal = nullptr;
+        stream.sent.clear();
+        return SceneResult::Failed;
+    }
+    stream.forget.clear();
+    if (error != Error::NONE) {
+        static uint64_t lastLog = 0;
+        if (lastLog == 0 || mFrame - lastLog >= 60) {
+            lastLog = mFrame;
+            ALOGI("task %d: scene of %zu layers refused (%d)", taskId, layers.size(),
+                  static_cast<int32_t>(error));
+        }
+        // Not imported (or not known to be): send the handle again next time.
+        for (uint64_t id : newlySent) stream.sent.erase(id);
+    }
+    switch (error) {
+        case Error::NONE:
+            return SceneResult::Posted;
+        case Error::NOT_VALIDATED:
+            return SceneResult::NotReady;
+        case Error::BAD_PARAMETER:
+            // The HAL lost its imports (reconnect, restart): resend handles.
+            ALOGI("task %d: HAL dropped its buffer cache, resending", taskId);
+            stream.sent.clear();
+            return SceneResult::Failed;
+        case Error::BAD_DISPLAY:
+        case Error::BAD_LAYER:
+            return SceneResult::Refused;
+        case Error::UNSUPPORTED:
+            return SceneResult::Unsupported;
+        default:
+            return SceneResult::Failed;
+    }
+}
