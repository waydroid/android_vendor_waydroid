+    }
+    // Formats Mir's android_wlegl and dmabuf importers sample like GLES.
+    switch (s.externalTexture->getBuffer()->getPixelFormat()) {
+        case PIXEL_FORMAT_RGBA_8888:
+        case PIXEL_FORMAT_RGBX_8888:
+        case PIXEL_FORMAT_BGRA_8888:
+        case PIXEL_FORMAT_RGB_565:
+            break;
+        default:
+            return "pixel format";
+    }
+    if (static_cast<uint32_t>(o.bufferTransform) > 7) return "transform";
+    return nullptr;
+}
+
+// Host reads of buffers shown directly. pending counts captures that have
+// not decided yet; fence covers every host read posted so far.
+struct HostRead {
+    int pending = 0;
+    sp<Fence> fence;
+};
+std::mutex gHostReadsMutex;
+std::condition_variable gHostReadsChanged;
+std::unordered_map<uint64_t, HostRead> gHostReads;
+std::atomic<bool> gHostReadsUsed{false};
+
+bool isDone(const sp<Fence>& fence) {
+    return !fence || !fence->isValid() || fence->getStatus() == Fence::Status::Signaled;
+}
+
+void markHostReadPending(uint64_t id) {
+    std::lock_guard lock(gHostReadsMutex);
+    gHostReadsUsed = true;
+    if (gHostReads.size() > 512) {
+        std::erase_if(gHostReads, [](const auto& entry) {
+            return entry.second.pending == 0 && isDone(entry.second.fence);
+        });
+    }
+    gHostReads[id].pending++;
+}
+
+void resolveHostRead(uint64_t id, const sp<Fence>& fence) {
+    {
+        std::lock_guard lock(gHostReadsMutex);
+        auto it = gHostReads.find(id);
+        if (it == gHostReads.end()) return;
+        auto& read = it->second;
+        if (!isDone(fence)) {
+            read.fence = isDone(read.fence) ? fence : Fence::merge("WaydroidHostRead", read.fence, fence);
+        }
+        if (read.pending > 0) read.pending--;
+        if (read.pending == 0 && isDone(read.fence)) gHostReads.erase(it);
+    }
+    gHostReadsChanged.notify_all();
+}
 } // namespace
 
+sp<Fence> waydroidHostReadFence(uint64_t bufferId) {
+    if (!gHostReadsUsed.load(std::memory_order_relaxed)) return Fence::NO_FENCE;
+    std::unique_lock lock(gHostReadsMutex);
+    if (gHostReads.find(bufferId) == gHostReads.end()) return Fence::NO_FENCE;
+    const bool decided = gHostReadsChanged.wait_for(lock, kPendingWait, [bufferId] {
+        auto it = gHostReads.find(bufferId);
+        return it == gHostReads.end() || it->second.pending == 0;
+    });
+    auto it = gHostReads.find(bufferId);
+    if (it == gHostReads.end()) return Fence::NO_FENCE;
+    if (!decided) {
+        ALOGW("buffer %" PRIu64 ": released before its capture decided", bufferId);
+    }
+    if (isDone(it->second.fence)) {
+        if (it->second.pending == 0) gHostReads.erase(it);
+        return Fence::NO_FENCE;
+    }
+    return it->second.fence;
+}
+
+sp<Fence> waydroidMergeHostRead(uint64_t bufferId, const sp<Fence>& releaseFence) {
+    sp<Fence> host = waydroidHostReadFence(bufferId);
+    if (!host->isValid()) return releaseFence;
+    if (!releaseFence || !releaseFence->isValid()) return host;
+    return Fence::merge("WaydroidRelease", releaseFence, host);
+}
+
+WaydroidTaskStreams::PendingReads::~PendingReads() {
+    for (uint64_t id : ids) {
+        auto it = hostFences.find(id);
+        resolveHostRead(id, it == hostFences.end() ? nullptr : it->second);
+    }
+}
