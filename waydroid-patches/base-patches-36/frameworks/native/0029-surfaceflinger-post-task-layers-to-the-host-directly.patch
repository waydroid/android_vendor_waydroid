+// Why this layer cannot be shown as its own subsurface, or null. Mir has no
+// per-surface alpha, color management or effects: anything SurfaceFlinger
+// would draw differently from the plain buffer is composed instead.
+const char* directRejectReason(const frontend::LayerSnapshot& s,
+                               const compositionengine::impl::OutputLayerCompositionState& o,
+                               int32_t width, int32_t height) {
+    if (s.forceClientComposition || o.forceClientComposition) return "client composition";
+    if (s.hasProtectedContent) return "protected content";
+    if (s.hasBlur()) return "blur";
+    if (s.drawShadows() || s.hasBoxShadowSettings()) return "shadow";
+    if (s.hasBorderSettings()) return "border";
+    if (s.roundedCorner.hasRoundedCorners()) return "rounded corners";
+    if (s.stretchEffect.hasEffect() || s.edgeExtensionEffect.hasEffect()) return "effect";
+    if (!s.colorTransformIsIdentity) return "color transform";
+    if (s.sidebandStream) return "sideband stream";
+    if (s.hdrMetadata.validTypes || s.luts) return "hdr";
+    if (o.dimmingRatio != 1.0f) return "dimming";
+    if (o.overrideInfo.buffer) return "cached override";
+    const auto& r = o.displayFrame;
+    if (r.isEmpty() || r.left < 0 || r.top < 0 || r.right > width || r.bottom > height) {
+        return "outside the task";
+    }
+    if (!s.externalTexture) {
+        return s.fillsColor() ? nullptr : "no content";
+    }
+    if (s.isFrontBuffered()) return "front buffered";
+    if (s.alpha < 1.0f) return "alpha";
+    switch (o.dataspace) {
+        case ui::Dataspace::UNKNOWN:
+        case ui::Dataspace::SRGB:
+        case ui::Dataspace::V0_SRGB:
+            break;
+        default:
