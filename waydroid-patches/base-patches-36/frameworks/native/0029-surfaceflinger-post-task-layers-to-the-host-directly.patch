+bool WaydroidTaskStreams::collectSnapshots(SurfaceFlinger::ScreenshotArgs& args,
+                                           PendingReads& pending) {
+    // setScreenshotSnapshotsAndDisplayState, plus marking every captured
+    // buffer as pending in the same main-thread hop: a release of one of
+    // them that races our post then waits for the decision instead of
+    // missing the host read.
+    const status_t status =
+            mFlinger.mScheduler
+                    ->schedule([&]() REQUIRES(kMainThreadContext) -> status_t {
+                        status_t s = mFlinger.setScreenshotDisplayState(args);
+                        if (s != OK) return s;
+                        auto layers = mFlinger.getLayerSnapshotsForScreenshots(
+                                args.snapshotRequest);
+                        if (!layers.ok()) return layers.error();
+                        args.layers = std::move(layers.value());
+                        args.hasProtectedLayer = mFlinger.layersHasProtectedLayer(args.layers);
+                        for (auto& [layer, layerFE] : args.layers) {
+                            mFlinger.attachReleaseFenceFutureToLayer(layer, layerFE.get(),
+                                                                     ui::UNASSIGNED_LAYER_STACK);
+                            const auto& texture = layerFE->mSnapshot->externalTexture;
+                            if (texture) {
+                                const uint64_t id = texture->getBuffer()->getId();
+                                markHostReadPending(id);
+                                pending.ids.push_back(id);
+                            }
+                        }
+                        return OK;
+                    })
+                    .get();
+    if (status != OK) {
+        ALOGW("snapshot collection failed (%d)", status);
+        return false;
+    }
+    return true;
+}
