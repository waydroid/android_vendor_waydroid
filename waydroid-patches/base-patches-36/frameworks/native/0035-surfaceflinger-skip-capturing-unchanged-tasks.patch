From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Fri, 6 Nov 2026 19:51:15 +0200
Subject: [PATCH] surfaceflinger: skip capturing unchanged tasks

Every SF frame captured and posted each wanted task, even when nothing
in it changed. Hash each task's layer state on the main thread and skip
the capture while it matches what the card already shows. An unchanged
task is still refreshed once a second while SF composes.

A composed frame taken while the scene settles arms the flush retry,
so a screen that goes static still ends up direct.

Change-Id: I5d42bd86b670f4f207af93bcb9bc6ae0ec567e58
---
 .../surfaceflinger/WaydroidTaskStreams.cpp    | 91 +++++++++++++++++--
 services/surfaceflinger/WaydroidTaskStreams.h | 11 ++-
 2 files changed, 91 insertions(+), 11 deletions(-)

diff --git a/services/surfaceflinger/WaydroidTaskStreams.cpp b/services/surfaceflinger/WaydroidTaskStreams.cpp
index 7ec0b2edbe..f8be73f82b 100644
--- a/services/surfaceflinger/WaydroidTaskStreams.cpp
+++ b/services/surfaceflinger/WaydroidTaskStreams.cpp
@@ -84,6 +84,8 @@ constexpr size_t kMaxSentBuffers = 48;
 constexpr uint64_t kSentIdleFrames = 120;
 // Direct frames in a row after which a task's composition buffers are freed.
 constexpr int kFreeTargetsAfter = 120;
+// An unchanged task is captured again after this long, if SF composes.
+constexpr nsecs_t kRefreshNs = ms2ns(1000);
 // How long a release on the main thread may wait for the streams thread to
 // decide whether a captured buffer went to the host.
 constexpr auto kPendingWait = std::chrono::milliseconds(20);
@@ -350,6 +352,46 @@ void WaydroidTaskStreams::onCompositionPresented(const frontend::LayerHierarchy&
         }
     }
 
+    // Content signature for the work gate. Per-layer hashes are summed, so
+    // the set's iteration order does not matter; globalZ catches reorders.
+    for (auto& task : tasks) {
+        for (const uint32_t id : task.layerIds) {
+            const auto* s = mFlinger.mLayerSnapshotBuilder.getSnapshot(id);
+            if (!s) continue;
+            if (s->contentDirty || s->autoRefresh || s->sidebandStream) task.dirty = true;
+            uint64_t h = 14695981039346656037ull;
+            auto mix = [&h](uint64_t v) {
+                h ^= v;
+                h *= 1099511628211ull;
+            };
+            auto mixf = [&mix](float f) {
+                uint32_t bits;
+                memcpy(&bits, &f, sizeof(bits));
+                mix(bits);
+            };
+            mix(id);
+            mix(s->globalZ);
+            mix(s->isVisible);
+            mix(s->buffer ? s->buffer->getId() : 0);
+            mix(s->frameNumber);
+            mix(s->geomBufferTransform);
+            mix(static_cast<uint64_t>(s->dataspace));
+            mix(static_cast<uint64_t>(s->blendMode));
+            mix(s->isOpaque);
+            const ui::Transform& t = s->geomLayerTransform;
+            for (const float f : {t.dsdx(), t.dtdx(), t.dtdy(), t.dsdy(), t.tx(), t.ty()}) mixf(f);
+            for (const FloatRect& r : {s->geomLayerBounds, s->geomCrop, s->roundedCorner.cropRect}) {
+                for (const float f : {r.left, r.top, r.right, r.bottom}) mixf(f);
+            }
+            for (const float f : {float(s->alpha), float(s->color.r), float(s->color.g),
+                                  float(s->color.b), float(s->color.a),
+                                  s->shadowSettings.length}) {
+                mixf(f);
+            }
+            task.contentSig += h;
+        }
+    }
+
     {
         std::lock_guard lock(mInputTokensMutex);
         mInputTokens = std::move(inputTokens);
@@ -419,6 +461,7 @@ bool WaydroidTaskStreams::renderTasks(const std::vector<TaskCapture>& tasks) {
             stream.lastSeenFrame = mFrame;
             continue;
         }
+        stream.havePostedSig = false;
         for (auto& slot : stream.slots) {
             if (!slot.busy && slot.texture) {
                 slot.texture = nullptr;
@@ -463,6 +506,7 @@ bool WaydroidTaskStreams::renderTasks(const std::vector<TaskCapture>& tasks) {
             // own buffers, replace it with a composed copy first: the host
             // would otherwise hold an app buffer for as long as the card idles.
             auto& stream = mStreams[task.taskId];
+            stream.havePostedSig = false;
             if (stream.lastDirect) renderTask(task, stream, false, true /*park*/);
             continue;
         }
@@ -482,6 +526,22 @@ bool WaydroidTaskStreams::renderTask(const TaskCapture& task, TaskStream& stream
         return false;
     }
 
+    // Work gate: the card already shows this content. Refresh now and then
+    // in case the host lost it, but only while SF composes anyway.
+    if (!park && !dump && !task.dirty && stream.havePostedSig &&
+        task.contentSig == stream.postedSig && systemTime() - stream.postedAt < kRefreshNs) {
+        if (++stream.idleFrames % kLogEveryFrames == 0) {
+            ALOGI("task %d: %d unchanged frames skipped", task.taskId, stream.idleFrames);
+        }
+        return false;
+    }
+    stream.havePostedSig = false;
+    const auto posted = [&] {
+        stream.postedSig = task.contentSig;
+        stream.havePostedSig = true;
+        stream.postedAt = systemTime();
+    };
+
     // Scenes need the release futures attached in our own main-thread hop,
     // which only works with a threaded RenderEngine (see collectSnapshots).
     const bool scenes = directLayersEnabled() && mFlinger.mRenderEngine->isThreaded();
@@ -568,6 +628,7 @@ bool WaydroidTaskStreams::renderTask(const TaskCapture& task, TaskStream& stream
         slot = stream.nextSlot;
     }
 
+    stream.settling = false;
     SceneResult direct = SceneResult::Unsupported;
     if (scenes && !park && !dump) {
         direct = tryDirect(task, stream, args, pending);
@@ -579,6 +640,7 @@ bool WaydroidTaskStreams::renderTask(const TaskCapture& task, TaskStream& stream
                       stream.directFrames, stream.composedScenes);
             }
             if (++stream.directRun >= kFreeTargetsAfter) freeTargets(task.taskId, stream);
+            posted();
             return false;
         }
     }
@@ -632,7 +694,7 @@ bool WaydroidTaskStreams::renderTask(const TaskCapture& task, TaskStream& stream
         return false;
     }
 
-    bool posted = false;
+    bool sent = false;
     if (scenes && direct != SceneResult::NotReady && direct != SceneResult::Refused) {
         // Same transport as the direct scenes, so the HAL applies both in
         // order and the switch between them cannot reorder frames.
@@ -660,30 +722,33 @@ bool WaydroidTaskStreams::renderTask(const TaskCapture& task, TaskStream& stream
             stream.slots[slot].release = releases.empty() ? nullptr : releases[0];
             stream.lastDirect = false;
             stream.composedScenes++;
-            posted = true;
+            sent = true;
         } else if (result != SceneResult::NotReady) {
             return false;
         }
     }
-    if (!posted) {
+    if (!sent) {
         // No configured window yet: postTaskBuffer creates it.
-        postBuffer(task.taskId, slot, stream, fenceResult.value());
+        sent = postBuffer(task.taskId, slot, stream, fenceResult.value());
     }
 
     stream.renderTotalNs += systemTime() - start;
     if (++stream.renderedFrames % kLogEveryFrames == 0) {
         ALOGI("task %d: %d frames rendered, avg %.2f ms, %d empty, %d starved, %d unstable,"
-              " %d post failures, %zu layers last frame",
+              " %d post failures, %d idle, %zu layers last frame",
               task.taskId, stream.renderedFrames,
               stream.renderTotalNs / 1e6 / stream.renderedFrames, stream.emptyFrames,
               stream.starvedFrames, stream.unstableFrames, stream.postFailures,
-              args.layers.size());
+              stream.idleFrames, args.layers.size());
     }
 
     if (dump) {
         fenceResult.value()->waitForever(LOG_TAG);
         dumpBuffer(task.taskId, texture->getBuffer());
     }
+    // Composed while the shape settles: come back for the direct scene.
+    if (stream.settling) return true;
+    if (sent) posted();
     return false;
 }
 
@@ -894,7 +959,10 @@ WaydroidTaskStreams::SceneResult WaydroidTaskStreams::tryDirect(
     }
     // A shape the host could not place stays composed until it changes.
     if (stream.haveRefusedShape && shape == stream.refusedShape) return SceneResult::Unsupported;
-    if (!stream.lastDirect && now - stream.shapeSince < kSettleNs) return SceneResult::Unsupported;
+    if (!stream.lastDirect && now - stream.shapeSince < kSettleNs) {
+        stream.settling = true;
+        return SceneResult::Unsupported;
+    }
 
     std::vector<sp<Fence>> releases;
     const SceneResult result = postScene(task.taskId, stream, static_cast<uint32_t>(width),
@@ -982,6 +1050,7 @@ WaydroidTaskStreams::SceneResult WaydroidTaskStreams::postScene(
         ALOGW("display@1.3 died (%s), reconnecting", ret.description().c_str());
         mHal = nullptr;
         stream.sent.clear();
+        for (auto& [id, s] : mStreams) s.havePostedSig = false;
         return SceneResult::Failed;
     }
     stream.forget.clear();
@@ -1077,14 +1146,14 @@ WaydroidTaskStreams::Gate WaydroidTaskStreams::queryWantedTasks(
     return error == Error::NONE ? Gate::Active : Gate::Inactive;
 }
 
-void WaydroidTaskStreams::postBuffer(int32_t taskId, uint32_t slot, TaskStream& stream,
+bool WaydroidTaskStreams::postBuffer(int32_t taskId, uint32_t slot, TaskStream& stream,
                                      const sp<Fence>& fence) {
     using ::android::hardware::hidl_handle;
     using ::android::hardware::hidl_vec;
     using ::android::hardware::graphics::composer::V2_1::Error;
 
     if (!connectHal()) {
-        return;
+        return false;
     }
 
     const sp<GraphicBuffer>& buffer = stream.slots[slot].texture->getBuffer();
@@ -1117,7 +1186,8 @@ void WaydroidTaskStreams::postBuffer(int32_t taskId, uint32_t slot, TaskStream&
     if (!ret.isOk()) {
         ALOGW("display@1.3 died (%s), reconnecting", ret.description().c_str());
         mHal = nullptr;
-        return;
+        for (auto& [id, s] : mStreams) s.havePostedSig = false;
+        return false;
     }
     if (error == Error::NONE) {
         stream.slots[slot].busy = true;
@@ -1138,6 +1208,7 @@ void WaydroidTaskStreams::postBuffer(int32_t taskId, uint32_t slot, TaskStream&
             stream.consecutiveRefused = 0;
         }
     }
+    return error == Error::NONE;
 }
 
 void WaydroidTaskStreams::dumpBuffer(int32_t taskId, const sp<GraphicBuffer>& buffer) {
diff --git a/services/surfaceflinger/WaydroidTaskStreams.h b/services/surfaceflinger/WaydroidTaskStreams.h
index c45b8a0c18..2ca8fe6860 100644
--- a/services/surfaceflinger/WaydroidTaskStreams.h
+++ b/services/surfaceflinger/WaydroidTaskStreams.h
@@ -71,6 +71,9 @@ private:
         std::unordered_set<uint32_t> layerIds;
         std::vector<uint32_t> members;
         uint64_t rootSig = 14695981039346656037ull;
+        // Everything a capture of the task would show; dirty forces a capture.
+        uint64_t contentSig = 0;
+        bool dirty = false;
     };
 
     // Three buffers per task: Mir holds current + previous, and a release
@@ -120,6 +123,12 @@ private:
         int composedScenes = 0;
         int directRun = 0;
         uint64_t lastRejectLog = 0;
+        // Work gate: the content the card already shows.
+        uint64_t postedSig = 0;
+        bool havePostedSig = false;
+        nsecs_t postedAt = 0;
+        bool settling = false;
+        int idleFrames = 0;
     };
 
     // Buffers of one capture that are waiting for a direct/composed decision.
@@ -158,7 +167,7 @@ private:
                           std::vector<SceneLayer>& layers, std::vector<sp<Fence>>* releases);
     bool connectHal();
     Gate queryWantedTasks(const std::vector<TaskCapture>& tasks);
-    void postBuffer(int32_t taskId, uint32_t slot, TaskStream& stream, const sp<Fence>& fence);
+    bool postBuffer(int32_t taskId, uint32_t slot, TaskStream& stream, const sp<Fence>& fence);
     void dumpBuffer(int32_t taskId, const sp<GraphicBuffer>& buffer);
 
     SurfaceFlinger& mFlinger;
