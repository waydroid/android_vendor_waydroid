     pthread_setspecific(mIsHost ? gHostTLS : gTLS, this);
     clearCaller();
@@ -1593,6 +1594,9 @@ status_t IPCThreadState::executeCommand(int32_t cmd)
             //    (mCallingSid ? mCallingSid : "<N/A>"), mCallingUid);
 
             Parcel reply;
+            // Waydroid dual-driver: binders written into the reply belong to the
+            // device the transaction arrived on, not the container's.
+            reply.SetIsHost(mIsHost);
             status_t error;
             IF_LOG_TRANSACTIONS() {
                 std::ostringstream logStream;
