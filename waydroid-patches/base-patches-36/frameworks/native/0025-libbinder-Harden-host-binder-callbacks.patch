Subject: [PATCH] libbinder: Harden host binder callbacks

Change-Id: I8f488a5c689a136ad7383d9cf0a57653e325513a
---
 libs/binder/BackendUnifiedServiceManager.cpp | 74 ++++++++++++++++++--
 libs/binder/BpBinder.cpp                     |  8 +--
 libs/binder/IPCThreadState.cpp               |  6 +-
 libs/binder/IServiceManager.cpp              |  6 +-
 libs/binder/Parcel.cpp                       | 10 ++-
 libs/binder/include/binder/IBinder.h         |  4 ++
 6 files changed, 91 insertions(+), 17 deletions(-)

diff --git a/libs/binder/BackendUnifiedServiceManager.cpp b/libs/binder/BackendUnifiedServiceManager.cpp
index 65b95cc..1535a72 100644
--- a/libs/binder/BackendUnifiedServiceManager.cpp
+++ b/libs/binder/BackendUnifiedServiceManager.cpp
@@ -354,19 +354,69 @@ bool BackendUnifiedServiceManager::returnIfCached(const std::string& serviceName
     return false;
 }
 
+// The host servicemanager, or null when the host driver is absent.
+static sp<IBinder> hostServicemanager(const char* why) {
+    sp<ProcessState> host = ProcessState::self(/*isHost=*/true);
+    if (host == nullptr || host->getDriverName().empty()) {
+        ALOGW("Waydroid: host ProcessState unavailable for %s", why);
+        return nullptr;
+    }
+    // A host service is never a pure client relationship: we hand container-side
+    // Bn objects to it (ICameraProviderCallback, IServiceCallback, ...) and the
+    // host calls back on /dev/host_binder. Nothing reads that fd unless the host
+    // ProcessState has a thread pool, so callbacks would only ever be seen while
+    // some thread happens to block in an outbound host transaction.
+    // No-op once started.
+    host->startThreadPool();
+    sp<IBinder> ctx = host->getContextObject(nullptr);
+    if (ctx == nullptr) {
+        ALOGW("Waydroid: no host servicemanager context for %s", why);
+    }
+    return ctx;
+}
+
+// Service (un)registration notifications for a host name. The container's own
+// servicemanager does not own host names, so a registration there can never
+// fire -- and clients that re-acquire a HAL from onRegistration() (cameraserver
+// after a provider crash) would hold a dead binder until they restart.
+static Status hostServiceNotifications(const std::string& name,
+                                       const sp<os::IServiceCallback>& callback, bool add) {
+    if (hostServicemanagerIsPreA16()) {
+        // A16 shifted every transaction code after checkService, and only the
+        // checkService bridge above is wire-compatible. Sending a pre-A16 host
+        // our (un)registerForNotifications code would hit an unrelated method.
+        ALOGW("Waydroid: pre-A16 host servicemanager, no service notifications for %s",
+              name.c_str());
+        return Status::ok();
+    }
+    sp<IBinder> ctx = hostServicemanager(name.c_str());
+    if (ctx == nullptr) return Status::ok();
+    sp<AidlServiceManager> hostSm = interface_cast<AidlServiceManager>(ctx);
+    if (hostSm == nullptr) {
+        ALOGW("Waydroid: host context is not an AidlServiceManager");
+        return Status::ok();
+    }
+    Status status = add ? hostSm->registerForNotifications(name, callback)
+                        : hostSm->unregisterForNotifications(name, callback);
+    if (!status.isOk()) {
+        // Soft-fail: a client that cannot get notifications should still keep
+        // the service it already resolved (CameraProviderManager treats an
+        // error here as fatal to enumeration).
+        ALOGW("Waydroid: host %sregisterForNotifications(%s) failed: %s", add ? "" : "un",
+              name.c_str(), status.toString8().c_str());
+        return Status::ok();
+    }
+    ALOGI("Waydroid: host %sregistered notifications for %s", add ? "" : "un", name.c_str());
+    return Status::ok();
+}
+
 Status BackendUnifiedServiceManager::queryHostService(const std::string& name,
                                                       os::Service* _out) {
     *_out = os::Service::make<os::Service::Tag::serviceWithMetadata>(
             createServiceWithMetadata(nullptr, false));
 
-    sp<ProcessState> host = ProcessState::self(/*isHost=*/true);
-    if (host == nullptr || host->getDriverName().empty()) {
-        ALOGW("Waydroid: host ProcessState unavailable for %s", name.c_str());
-        return Status::ok();
-    }
-    sp<IBinder> ctx = host->getContextObject(nullptr);
+    sp<IBinder> ctx = hostServicemanager(name.c_str());
     if (ctx == nullptr) {
-        ALOGW("Waydroid: no host servicemanager context for %s", name.c_str());
         return Status::ok();
     }
     // Stability is already set by getContextObject()'s markCompilationUnit().
@@ -418,6 +468,10 @@ Status BackendUnifiedServiceManager::getService2(const ::std::string& name, os::
     if (status.isOk()) {
         status = toBinderService(name, service, _out);
         if (status.isOk()) {
+            // Deliberately no host retry here: getService() is the blocking
+            // variant and already funnels through checkService(), so host names
+            // are covered there. Hooking it here too would put a host round-trip
+            // (and the pre-A16 probe) on a path that waits.
             return updateCache(name, service);
         }
     }
@@ -578,6 +632,9 @@ Status BackendUnifiedServiceManager::listServices(int32_t dumpPriority,
 }
 Status BackendUnifiedServiceManager::registerForNotifications(
         const ::std::string& name, const sp<os::IServiceCallback>& callback) {
+    if (isHostAidlService(name)) {
+        return hostServiceNotifications(name, callback, /*add=*/true);
+    }
     if (mTheRealServiceManager) {
         return mTheRealServiceManager->registerForNotifications(name, callback);
     }
@@ -586,6 +643,9 @@ Status BackendUnifiedServiceManager::registerForNotifications(
 }
 Status BackendUnifiedServiceManager::unregisterForNotifications(
         const ::std::string& name, const sp<os::IServiceCallback>& callback) {
+    if (isHostAidlService(name)) {
+        return hostServiceNotifications(name, callback, /*add=*/false);
+    }
     if (mTheRealServiceManager) {
         return mTheRealServiceManager->unregisterForNotifications(name, callback);
     }
diff --git a/libs/binder/BpBinder.cpp b/libs/binder/BpBinder.cpp
