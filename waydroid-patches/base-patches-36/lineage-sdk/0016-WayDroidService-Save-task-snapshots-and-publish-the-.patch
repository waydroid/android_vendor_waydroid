@@ -536,28 +543,74 @@ public class WayDroidService extends LineageSystemService {
                 public void onTaskMovedToFront(int taskId) {
                     BackgroundThread.getHandler().post(WayDroidService.this::syncActiveApps);
                 }
+
+                @Override
