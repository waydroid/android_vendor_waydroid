From a868b5e91c1517b2d5c39374ddfba761251efd3e Mon Sep 17 00:00:00 2001
From: Asriel Dreemurr <asriel.danctnix@gmail.com>
Date: Thu, 22 Jan 2026 09:28:12 +0000
Subject: [PATCH 1/6] (waydroid) add /vendor_extra/lib*/hw to HAL search path

Change-Id: I1a3942554538aeff6bfbb784bf0b3eaacab01ddc
---
 hardware.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/hardware.c b/hardware.c
index a89077d..a0cdea2 100644
--- a/hardware.c
+++ b/hardware.c
@@ -48,6 +48,7 @@
 #define HAL_LIBRARY_PATH1 "/system/" HAL_LIBRARY_SUBDIR
 #define HAL_LIBRARY_PATH2 "/vendor/" HAL_LIBRARY_SUBDIR
 #define HAL_LIBRARY_PATH3 "/odm/" HAL_LIBRARY_SUBDIR
+#define HAL_LIBRARY_PATH4 "/vendor_extra/" HAL_LIBRARY_SUBDIR
 
 /**
  * There are a set of variant filename for modules. The form of the filename
@@ -209,6 +210,12 @@ static int hw_module_exists(char *path, size_t path_len, const char *name,
         return 0;
 #endif
 
+    // Waydroid: check inside vendor_extra path as last fallback
+    snprintf(path, path_len, "%s/%s.%s.so",
+             HAL_LIBRARY_PATH4, name, subname);
+    if (path_in_path(path, HAL_LIBRARY_PATH4) && access(path, R_OK) == 0)
+        return 0;
+
 #endif // __ANDROID_APEX__
 
     return -ENOENT;
